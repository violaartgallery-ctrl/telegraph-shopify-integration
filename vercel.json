{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build && npm run prisma:deploy",
  "functions": {
    "api/index.ts": { "maxDuration": 300 },
    "api/production-continuation-queue.ts": {
      "maxDuration": 300,
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "viola-production-continuations",
          "retryAfterSeconds": 360,
          "initialDelaySeconds": 0
        }
      ]
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api" }
  ]
}
