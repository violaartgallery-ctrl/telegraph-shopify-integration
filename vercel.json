{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "functions": {
    "api/index.ts": { "maxDuration": 300 },
    "api/ops-scheduler-queue.ts": {
      "maxDuration": 300,
      "experimentalTriggers": [{ "type": "queue/v2beta", "topic": "viola-ops-scheduler", "retryAfterSeconds": 60, "initialDelaySeconds": 0 }]
    },
    "api/production-continuation-queue.ts": {
      "maxDuration": 300,
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "viola-production-continuations",
          "retryAfterSeconds": 360,
          "initialDelaySeconds": 0
        }
      ]
    }
  },
  "crons": [{ "path": "/ops/scheduler/ensure", "schedule": "13 0 * * *" }],
  "rewrites": [
    { "source": "/(.*)", "destination": "/api" }
  ]
}
